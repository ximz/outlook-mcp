# Outlook MCP Server Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Volume Mount Path (host-side, for docker-compose) ===
# This is where your authentication tokens are stored on your local machine.
# The container will mount this directory to persist tokens.

# Mac/Linux:
MSGRAPH_TOKEN_PATH=~/.msgraph

# Windows (use forward slashes):
# MSGRAPH_TOKEN_PATH=C:/Users/YourName/.msgraph

# === Microsoft Graph API Credentials ===
# Get these from Azure Portal > App Registrations > Your App
# Required for authentication with Microsoft Graph API

MS_CLIENT_ID=your-client-id-here

# Client secret is OPTIONAL for device code flow (public client apps)
# Only needed if you're using confidential client flow
# MS_CLIENT_SECRET=your-client-secret-here
